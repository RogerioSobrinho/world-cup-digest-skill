# Optional data providers for skills/world-cup-digest/scripts/world-cup-fetch.py
#
# The skill can still work with browser/web search if these are empty, but the
# fetcher becomes much more useful when one or more providers are configured.

WORLD_CUP_DIGEST_CACHE_DIR=~/.cache/world-cup-digest
WORLD_CUP_DIGEST_TIMEOUT=20
WORLD_CUP_DIGEST_CACHE_TTL_DEFAULT=300
WORLD_CUP_DIGEST_CACHE_TTL_LIVE=20
WORLD_CUP_DIGEST_CACHE_TTL_SCHEDULED=300
WORLD_CUP_DIGEST_CACHE_TTL_FINAL=86400

WC2026_API_KEY=
WC2026_API_BASE=https://api.wc2026api.com

THESTATSAPI_KEY=
THESTATSAPI_BASE=https://api.thestatsapi.com/api

API_FOOTBALL_KEY=
API_FOOTBALL_BASE=https://v3.football.api-sports.io

BALLDONTLIE_FIFA_KEY=
BALLDONTLIE_FIFA_BASE=https://fifa.balldontlie.io/api/v1

WORLDCUPAPI_KEY=
WORLDCUPAPI_BASE=https://worldcupapi.com/api
